<!-- iFrame oculto para capturar resposta do Mailchimp -->
<iframe name="hidden_iframe" id="hidden_iframe" style="display:none;"
  onload="if(window._eaSubmitted){window.location='https://enfermeiroaprovado.com.br/desafio-obrigado/';}">
</iframe>

<script>
  window._eaSubmitted = false;

  // Header shadow on scroll
  (function() {
    const onScroll = () => {
      if (window.scrollY > 24) document.body.classList.add('header-scrolled');
      else document.body.classList.remove('header-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll);
  })();

  // Form submission handler
  document.getElementById('mc-embedded-subscribe-form').addEventListener('submit', function() {
    window._eaSubmitted = true;
    setTimeout(function() {
      const el = document.getElementById('success-message');
      if (el) el.classList.add('show');
    }, 500);
  });

  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

</body>
